# SwiftColab Frontend Production Environment
# These variables are embedded at build time

# The production UI and API are served by the same Render service.
# Leave VITE_API_URL unset so requests use the current website origin.

# App name
VITE_APP_NAME=SwiftColab

# Feature flags (optional)
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
