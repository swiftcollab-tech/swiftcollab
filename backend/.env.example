PORT=4002

# OpenAI API Key (required for AI planning)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API Key (optional fallback provider)
GEMINI_API_KEY=

# OpenRouter API Key (optional free-model fallback provider)
OPENROUTER_API_KEY=

# auto = OpenAI, then Gemini, then OpenRouter; also accepts openai, gemini, or openrouter
AI_PROVIDER=auto

# Composio API Key (required for 500+ app integrations)
# Get your API key from: https://app.composio.dev/settings
COMPOSIO_API_KEY=your_composio_api_key_here

# Postgres / Supabase connection
# Prefer DATABASE_URL; the code will also read SUPABASE_DATABASE_URL / SUPABASE_POSTGRES_URL
DATABASE_URL=postgresql://user:password@host:5432/database
SUPABASE_DATABASE_URL=

# Optional cache for chat history, schemas, sessions, and distributed locks.
# PostgreSQL remains the durable source of truth when Redis is unavailable.
REDIS_URL=redis://localhost:6379

# Durable workflow execution is optional for the initial development deploy.
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=127.0.0.1:7233

# Legacy Google OAuth (optional - Composio handles this now)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4002/api/integrations/google/callback

# 32-byte base64 key used to encrypt OAuth tokens at rest. Generate a unique value
# for each environment; never commit the real value.
INTEGRATION_ENCRYPTION_KEY=generate_a_unique_32_byte_base64_key
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Authentication and browser session security
JWT_SECRET=generate_a_long_random_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_MS=604800000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Set only when the UI and API use subdomains of the same parent domain.
# Example: .swiftcollab.example
COOKIE_DOMAIN=

# Transactional invitation email (Resend)
RESEND_API_KEY=
# Must be a verified sender on your domain, e.g. SwiftCollab <invite@swiftcollab.example>
EMAIL_FROM=
SUPPORT_EMAIL=support@swiftcollab.tech

# Legacy Slack Secrets (optional - Composio handles this now)
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
