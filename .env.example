# Public URL of the deployed API. Vite embeds this value during the frontend build.
VITE_API_URL=http://localhost:4002
VITE_APP_NAME=SwiftCollab

# Native Google Workspace OAuth (backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4002/api/connectors/gmail/callback
